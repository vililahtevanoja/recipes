{
  "name": "personal-recipes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:no-apply": "if rg -n --fixed-strings '@apply' src; then echo 'Error: @apply is not allowed'; exit 1; fi",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest --run",
    "lint": "eslint .",
    "format": "concurrently -g 'oxfmt --config .oxfmtrc.jsonc --ignore-path .gitignore .' 'prettier --write .'",
    "format-check": "concurrently -g 'oxfmt --check --config .oxfmtrc.jsonc --ignore-path .gitignore .' 'prettier --check .'",
    "verify": "pnpm format-check && pnpm check:no-apply && pnpm check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "marked": "18.1.3",
    "mdsvex": "0.12.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/mcp": "0.1.30",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "10.6.2",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "oxfmt": "0.77.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
