{
  "name": "personal-recipes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:no-apply": "if rg -n --fixed-strings '@apply' src; then echo 'Error: @apply is not allowed'; exit 1; fi",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest --run",
    "lint": "eslint .",
    "format": "concurrently -g 'oxfmt --config .oxfmtrc.jsonc --ignore-path .gitignore .' 'prettier --write .'",
    "format-check": "concurrently -g 'oxfmt --check --config .oxfmtrc.jsonc --ignore-path .gitignore .' 'prettier --check .'",
    "verify": "pnpm format-check && pnpm check:no-apply && pnpm check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "marked": "18.0.11",
    "mdsvex": "0.12.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/eslint": "9.6.1",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "oxfmt": "0.65.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "zod": "4.5.2"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
